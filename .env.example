# Settings for docker-compose.yml. Copy to .env (which is not checked in).

# The domain the site is reached at. Its DNS must point to this server.
SITE_ADDRESS=laundry.example.com

# Signs the login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The code people need to create an account
INVITE_CODE=
